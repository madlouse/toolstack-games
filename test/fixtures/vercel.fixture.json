{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/CONTENT-POLICY.html",
      "destination": "/content-policy/",
      "permanent": true
    },
    {
      "source": "/CONTENT-POLICY",
      "destination": "/content-policy/",
      "permanent": true
    },
    {
      "source": "/CONTENT-POLICY/",
      "destination": "/content-policy/",
      "permanent": true
    },
    {
      "source": "/CONTENT-POLICY.md",
      "destination": "/content-policy/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://classics-example.pages.dev https://tsl-game1.pages.dev https://bloom-isle.gettoolstacklab.com; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/site.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/site.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    },
    {
      "source": "/og.(png|jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
