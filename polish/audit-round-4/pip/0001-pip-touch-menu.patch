From e1e8e676227ed19b7ef0589f2d4f55a07f927a52 Mon Sep 17 00:00:00 2001
From: EXP-28 Builder <builder@exp28.local>
Date: Fri, 30 Oct 2026 14:09:24 -0400
Subject: [PATCH] touch: hide stick/jump/dive while a menu is open; no keyboard
 legend on touch (hub R4 P1 #4)

---
 src/main.js   | 10 ++++++++++
 src/style.css |  3 +++
 2 files changed, 13 insertions(+)

diff --git a/src/main.js b/src/main.js
index 027aa8c..64b4869 100644
--- a/src/main.js
+++ b/src/main.js
@@ -671,10 +671,20 @@ function finaleCamera(dt, t) {
   camera.lookAt(c.x, c.y + Math.min(2, t * 0.3), c.z);
 }
 
+// Menus (title, pause, cleared, world-2 card, finish) own the screen: hide the touch stick/buttons so they
+// never sit on top of a menu button, and flag the body so CSS can hide the keyboard legend.
+const menuEls = ['title', 'pause', 'cleared', 'world2', 'finish'].map(id => document.getElementById(id));
+let menuOpen = null;
+function syncMenu() {
+  const open = menuEls.some(el => el && !el.hidden && el.style.display !== 'none' && (el.id !== 'finish' || el.style.display === 'flex'));
+  if (open !== menuOpen) { menuOpen = open; document.body.classList.toggle('menu', open); }
+}
+syncMenu();
 // ---------- loop ----------
 let last = performance.now(), fpsAcc = 0, fpsN = 0, lowFpsT = 0, wasUnder = false;
 function step(dt) {
   shared.time.value += dt; G.frames++;
+  syncMenu();
   readInput();
   if (started && !G.finished) G.time += dt;
   player.update(dt, started ? input : { x: 0, y: 0, jump: false, jumpPressed: false, dive: false }, camYaw);
diff --git a/src/style.css b/src/style.css
index e512969..cd68153 100644
--- a/src/style.css
+++ b/src/style.css
@@ -54,6 +54,9 @@ button{font:inherit;cursor:pointer}
 #finish{display:none;background:radial-gradient(ellipse,rgba(255,220,150,.0),rgba(60,30,80,.25))}
 #touch{display:none}
 body.touch #touch{display:block}
+/* menus own the screen on touch: no stick/buttons over menu buttons; no keyboard legend on touch screens */
+body.touch.menu #touch{display:none}
+body.touch #hint{display:none}
 #stick{position:fixed;left:24px;bottom:24px;width:130px;height:130px;border-radius:50%;background:rgba(255,255,255,.22);border:3px solid rgba(255,255,255,.6)}
 #knob{position:absolute;left:40px;top:40px;width:50px;height:50px;border-radius:50%;background:rgba(255,255,255,.85)}
 #bJump,#bDive{position:fixed;right:24px;bottom:30px;width:96px;height:96px;border-radius:50%;border:3px solid #fff;background:rgba(255,190,70,.85);color:#6a3a0a;font-size:20px}
